<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>This package defines the tUserPasskeyHandle and tUserPasskey tables: the IPasskeyStore and the "Passkey" login provider of the passkeys (WebAuthn) verified by the authentication center.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CK.DB.Auth" Version="30.0.3-0.cris-auth.0.ci.10" />
    <PackageReference Include="CK.AuthenticationInfo.Passkey" Version="14.0.2-0.cris-auth.0.ci.4" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="**\*.sql;**\*.tql;**\*.y4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CK.IO.User.UserPasskey\CK.IO.User.UserPasskey.csproj" />
  </ItemGroup>
</Project>
